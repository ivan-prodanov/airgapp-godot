[gd_resource type="ShaderMaterial" load_steps=2 format=2]

[sub_resource type="Shader" id=1]
code = "shader_type spatial;
render_mode blend_mix,depth_draw_opaque,cull_disabled,unshaded;
uniform vec4 albedo : hint_color;
uniform sampler2D texture_albedo : hint_albedo;
uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform float fade_intensity;
uniform float fade_intensity_y;
uniform float offset;

void vertex() {
	UV=UV*uv1_scale.xy+uv1_offset.xy;
}

void fragment() {
	vec2 base_uv = UV;
	vec4 albedo_tex = texture(texture_albedo,base_uv);
	ALBEDO = albedo.rgb * albedo_tex.rgb;
	float remapped_UVx = UV.x + offset;
	float distance_from_center_x = abs(remapped_UVx - 0.5) * 2.0;
	float distance_from_center_y = abs(UV.y - 0.5) * 2.0;
    float alpha = 1.0 - distance_from_center_x * fade_intensity;
	alpha = alpha - distance_from_center_y * fade_intensity_y;
	ALPHA = alpha * 0.7;
}
"

[resource]
render_priority = 21
shader = SubResource( 1 )
shader_param/albedo = Color( 0.447059, 1, 0.713726, 1 )
shader_param/uv1_scale = Vector3( 1, 1, 1 )
shader_param/uv1_offset = Vector3( 0, 0, 0 )
shader_param/fade_intensity = 4.0
shader_param/fade_intensity_y = 0.621
shader_param/offset = -0.75
