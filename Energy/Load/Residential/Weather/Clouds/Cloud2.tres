[gd_resource type="ShaderMaterial" load_steps=3 format=2]

[ext_resource path="res://Energy/Load/Residential/Weather/Clouds/PartiallyCloudy2.png" type="Texture" id=1]

[sub_resource type="Shader" id=1]
code = "shader_type spatial;
render_mode blend_add,depth_draw_opaque,cull_back,diffuse_burley,specular_schlick_ggx,unshaded;
uniform vec4 albedo : hint_color;
uniform vec4 albedo_dark : hint_color;
uniform sampler2D texture_albedo : hint_albedo;
uniform float point_size : hint_range(0,128);
uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform float alpha_factor: hint_range(0,1);
uniform vec4 sunset_color_1: hint_color;
uniform vec4 sunset_color_2: hint_color;
uniform float sunset_factor : hint_range(0,1);


void vertex() {
	UV=UV*uv1_scale.xy+uv1_offset.xy;	
}

void fragment() {
	vec2 base_uv = UV;
	vec4 albedo_tex = texture(texture_albedo,base_uv);
		vec3 white_albedo = albedo.rgb * albedo_tex.rgb;
	vec3 sunset_albedo = mix(sunset_color_1.rgb, sunset_color_2.rgb, (UV.y - 0.4) * 7.0);
//	ALBEDO = albedo.rgb * albedo_tex.rgb;
//	ALBEDO = mix(sunset_color_1.rgb, sunset_color_2.rgb, (UV.y - 0.5) * 3.0);
	ALBEDO = mix(white_albedo, sunset_albedo, sunset_factor);
	ALPHA = min(albedo.a * (albedo_tex.a * 1.2) * alpha_factor, 1.0);
}
"

[resource]
shader = SubResource( 1 )
shader_param/albedo = Color( 0.952941, 0.952941, 0.952941, 0.658824 )
shader_param/albedo_dark = Color( 0.278431, 0.278431, 0.278431, 0.647059 )
shader_param/point_size = 1.0
shader_param/uv1_scale = Vector3( 1, 1, 1 )
shader_param/uv1_offset = Vector3( 0, 0, 0 )
shader_param/alpha_factor = 1.0
shader_param/sunset_color_1 = Color( 0.717647, 0.466667, 0.713726, 1 )
shader_param/sunset_color_2 = Color( 0.854902, 0.65098, 0.411765, 1 )
shader_param/sunset_factor = 0.0
shader_param/texture_albedo = ExtResource( 1 )
