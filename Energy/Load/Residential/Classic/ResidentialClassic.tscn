	UV=UV*uv1_scale.xy+uv1_offset.xy;
}

void fragment() {
	vec2 base_uv = UV;
	vec4 albedo_tex = texture(texture_albedo,base_uv);
	vec4 rough_tex = texture(roughness_image, base_uv);
	ALBEDO = albedo.rgb * albedo_tex.rgb * (1.0 - rough_tex.r);
	ALPHA = pow(max(0.0, 1.0 - length(UV - 0.5) * size), fade_factor);
}
"

