[resource]
code = "shader_type spatial;
render_mode blend_add, unshaded, shadows_disabled;

uniform vec4 color : hint_color;
uniform float time;
uniform sampler2D Noise;



void vertex() {
// Output:0

}

void fragment() {
// ColorUniform:38
	vec3 n_out38p0 = color.rgb;
	float n_out38p1 = color.a;

// Input:31
	vec3 n_out31p0 = vec3(UV, 0.0);

// VectorOp:32
	vec3 n_in32p1 = vec3(1.50000, 0.35000, 1.00000);
	vec3 n_out32p0 = n_out31p0 * n_in32p1;

// ScalarUniform:37
	float n_out37p0 = time;

// ScalarOp:36
	float n_in36p1 = -0.80000;
	float n_out36p0 = n_out37p0 * n_in36p1;

// VectorCompose:34
	float n_in34p0 = 0.00000;
	float n_in34p2 = 0.00000;
	vec3 n_out34p0 = vec3(n_in34p0, n_out36p0, n_in34p2);

// VectorOp:33
	vec3 n_out33p0 = n_out32p0 + n_out34p0;

// TextureUniform:30
	vec3 n_out30p0;
	float n_out30p1;
	{
		vec4 n_tex_read = texture(Noise, n_out33p0.xy);
		n_out30p0 = n_tex_read.rgb;
		n_out30p1 = n_tex_read.a;
	}

// Expression:29
	float n_out29p0;
	n_out29p0 = 0.0;
	{
		float ampX = 1.0 - abs(n_out31p0.x-0.5)*2.0;
		float ampY = clamp(n_out31p0.y / 0.05,0.0,1.0);
		n_out29p0 = dot(n_out30p0, vec3(0.333333, 0.333333, 0.333333)) * (1.0-n_out31p0.y)*ampY*ampX*3.0;
	}

// Output:0
	ALBEDO = n_out38p0;
	ALPHA = n_out29p0;

}

void light() {
// Output:0

}
