extends Node

const CAMERA_PARKED = "parked"
const CAMERA_PLUGGED = "plugged"
const CAMERA_TOP_DOWN = "top_down"
const CAMERA_CLIMATE = "climate"
const LOCAL_PLATE_TEXT = "airgapp.net"
const FREE_ORBIT_MIN_PITCH = 1.0
const FREE_ORBIT_MAX_PITCH = 79.0
const FREE_ORBIT_YAW_SENSITIVITY = 0.16
const FREE_ORBIT_PITCH_SENSITIVITY = 0.06
const FREE_ORBIT_INERTIA_DAMPING = 5.0
const FREE_ORBIT_MIN_INERTIA_SPEED = 0.5
const LIGHTING_MOBILE = "mobile"
const LIGHTING_AMBIENT_FILL = "ambient_fill"
const LIGHTING_VIEW_RELATIVE = "view_relative"
const LIGHTING_MODE_ORDER = [LIGHTING_MOBILE, LIGHTING_AMBIENT_FILL, LIGHTING_VIEW_RELATIVE]
const VIEW_RELATIVE_ENV_YAW_THRESHOLD = 0.25
const UNSET_ENV_YAW = 999999.0

var web_export_dynamic_scenes = [
	preload("res://Ego/Wheels_Palladium/New_Turbine_22.tscn"),
	preload("res://Ego/Wheels_P3/Wheel_Cypress_NoInsert.tscn"),
	preload("res://Ego/Wheels_Palladium/Cyberstream.tscn"),
	preload("res://Ego/Wheels_Bayberry/Arachnid_V2/Arachnid_V2_21.tscn"),
]
var mobile_comm = null
var comm_interface = null
var vehicle_data: Dictionary = {}
var current_vehicle_id: String = "local-modely-performanceBayberry-model_y"
var booted: bool = false
var climate_on: bool = false
var front_defrost_on: bool = false
var rear_defrost_on: bool = false
var camera_mode: String = CAMERA_PARKED
var charger_connected: bool = false
var charging_active: bool = false
var drive_mode_on: bool = false
var manual_headlights_override_active: bool = false
var manual_headlights_on: bool = false
var manual_brake_lights_override_active: bool = false
var manual_brake_lights_on: bool = false
var current_theme: String = "dark"
var window_state: Dictionary = {
	"LFWindowAnimation": false,
	"RFWindowAnimation": false,
	"LRWindowAnimation": false,
	"RRWindowAnimation": false,
}
var local_fade_original_alpha: Dictionary = {}
var local_plate_text_viewport: Viewport = null
var local_plate_skin_texture: ImageTexture = null
var free_orbit_enabled: bool = false
var free_orbit_dragging: bool = false
var free_orbit_locked_pivot_rotation: Vector3 = Vector3.ZERO
var free_orbit_locked_camera_translation: Vector3 = Vector3.ZERO
var free_orbit_locked_camera_fov: float = 40.0
var free_orbit_locked_camera_mode: String = CAMERA_PARKED
var free_orbit_velocity: Vector2 = Vector2.ZERO
var web_controls_layer: CanvasLayer = null
var last_main_view_frame_size: Vector2 = Vector2.ZERO
var lighting_mode: String = LIGHTING_MOBILE
var env_base_rotation: Vector3 = Vector3(0, -7, 83)
var env_base_energy: float = 4.0
var env_base_ambient: float = 4.0
var lighting_reference_pivot_yaw: float = 0.0
var lighting_reference_env_rotation: Vector3 = Vector3(0, -7, 83)
var last_view_relative_env_yaw: float = UNSET_ENV_YAW


func setup(_mobile_comm, _comm_interface):
	mobile_comm = _mobile_comm
	comm_interface = _comm_interface


func _ready():
	set_process(true)
	set_process_input(true)
	call_deferred("_boot")


func _process(delta: float):
	_sync_main_view_frame_to_viewport(false)

	if not free_orbit_enabled or free_orbit_dragging:
		return
	if free_orbit_velocity.length() < FREE_ORBIT_MIN_INERTIA_SPEED:
		free_orbit_velocity = Vector2.ZERO
		return
	var pivot = _get_camera_pivot()
	if pivot == null:
		free_orbit_velocity = Vector2.ZERO
		return
	_apply_free_orbit_rotation_delta(pivot, free_orbit_velocity * delta)
	_sync_view_relative_lighting()
	free_orbit_velocity = free_orbit_velocity.linear_interpolate(Vector2.ZERO, min(1.0, FREE_ORBIT_INERTIA_DAMPING * delta))


func _boot():
	yield(get_tree(), "idle_frame")
	yield(get_tree(), "idle_frame")

	vehicle_data = _base_vehicle_data()

	_enqueue("APP_CONFIG", {
		"pixelRatio": 1.0,
		"fontScale": 1.0,
		"scaleFramebufferOnBackground": true,
	})
	_enqueue("GODOT_CONFIG", {
		"light_theme_color": "#F7F7F7",
		"dark_theme_color": "#161718",
	})
	_send_theme()
	_sync_main_view_frame_to_viewport(false, true)
	_enqueue("SHOW_PRODUCT", vehicle_data)
	_force_cable_unplugged()
	var plate_state = _apply_local_plate_visuals_before_camera(16)
	if plate_state is GDScriptFunctionState:
		yield(plate_state, "completed")
	_return_to_default_view(false)
	call_deferred("_apply_local_plate_visuals", 12)

	booted = true
	if OS.get_name() == "HTML5":
		print("[LocalDevMessageInjector] Web dynamic resources pinned: %d scenes" % web_export_dynamic_scenes.size())
		_create_web_controls()
	print("[LocalDevMessageInjector] Loaded local Bayberry renderer harness")
	print("[LocalDevMessageInjector] Keys: 5 S, 6 3, 7 X, 8 Y, F frunk, T trunk, 1/2 front doors, 3/4 rear doors, Q/W/E/R windows, A AC, C climate view, G front defrost, H rear defrost, P charge port door, V cable, B charging glow, D drive/wheel spin, J headlights, N brake lights, M camera, O free orbit, I lighting, L theme, K markers")


func _input(event):
	if not booted:
		return

	if free_orbit_enabled:
		_handle_free_orbit_input(event)

	if not (event is InputEventKey):
		return
	if not event.pressed or event.echo:
		return

	match event.scancode:
		KEY_F:
			_toggle_vehicle_state("ft")
		KEY_T:
			_toggle_vehicle_state("rt")
		KEY_1:
			_toggle_vehicle_state("df")
		KEY_2:
			_toggle_vehicle_state("pf")
		KEY_3:
			_toggle_vehicle_state("dr")
		KEY_4:
			_toggle_vehicle_state("pr")
		KEY_5:
			_show_vehicle_config(_vehicle_config_model_s(), "Model S")
		KEY_6:
			_show_vehicle_config(_vehicle_config_model_3(), "Model 3")
		KEY_7:
			_show_vehicle_config(_vehicle_config_model_x(), "Model X")
		KEY_8:
			_show_vehicle_config(_vehicle_config_model_y(), "Model Y")
		KEY_Q:
			_toggle_window("LFWindowAnimation")
		KEY_W:
			_toggle_window("RFWindowAnimation")
		KEY_E:
			_toggle_window("LRWindowAnimation")
		KEY_R:
			_toggle_window("RRWindowAnimation")
		KEY_A:
			_toggle_ac()
		KEY_C:
			_toggle_climate_view()
		KEY_G:
			_toggle_front_defrost()
		KEY_H:
			_toggle_rear_defrost()
		KEY_P:
			_toggle_charge_port()
		KEY_V:
			_toggle_charger_connected()
		KEY_B:
			_toggle_charging_active()
		KEY_D:
			_toggle_drive_mode()
		KEY_J:
			_toggle_headlights()
		KEY_N:
			_toggle_brake_lights()
		KEY_M:
			_send_camera_move()
		KEY_O:
			_toggle_free_orbit()
		KEY_I:
			_cycle_lighting_mode()
		KEY_L:
			_toggle_theme()
		KEY_K:
			_enqueue("GET_VEHICLE_MARKERS", {"vehicle_id": current_vehicle_id})


func _create_web_controls():
	if web_controls_layer != null:
		return
	web_controls_layer = CanvasLayer.new()
	web_controls_layer.name = "LocalWebControls"
	web_controls_layer.layer = 100
	add_child(web_controls_layer)

	var root = VBoxContainer.new()
	root.name = "Controls"
	root.anchor_left = 0.0
	root.anchor_top = 0.0
	root.anchor_right = 0.0
	root.anchor_bottom = 0.0
	root.margin_left = 12
	root.margin_top = 12
	root.margin_right = 640
	root.margin_bottom = 180
	root.add_constant_override("separation", 6)
	web_controls_layer.add_child(root)

	var vehicles = HBoxContainer.new()
	vehicles.add_constant_override("separation", 4)
	root.add_child(vehicles)
	_add_web_button(vehicles, "S", "_show_vehicle_config", [_vehicle_config_model_s(), "Model S"])
	_add_web_button(vehicles, "3", "_show_vehicle_config", [_vehicle_config_model_3(), "Model 3"])
	_add_web_button(vehicles, "X", "_show_vehicle_config", [_vehicle_config_model_x(), "Model X"])
	_add_web_button(vehicles, "Y", "_show_vehicle_config", [_vehicle_config_model_y(), "Model Y"])

	var closures = HBoxContainer.new()
	closures.add_constant_override("separation", 4)
	root.add_child(closures)
	_add_web_button(closures, "Frunk", "_toggle_vehicle_state", ["ft"])
	_add_web_button(closures, "Trunk", "_toggle_vehicle_state", ["rt"])
	_add_web_button(closures, "DF", "_toggle_vehicle_state", ["df"])
	_add_web_button(closures, "PF", "_toggle_vehicle_state", ["pf"])
	_add_web_button(closures, "DR", "_toggle_vehicle_state", ["dr"])
	_add_web_button(closures, "PR", "_toggle_vehicle_state", ["pr"])

	var actions = HBoxContainer.new()
	actions.add_constant_override("separation", 4)
	root.add_child(actions)
	_add_web_button(actions, "AC", "_toggle_ac")
	_add_web_button(actions, "Climate", "_toggle_climate_view")
	_add_web_button(actions, "Port", "_toggle_charge_port")
	_add_web_button(actions, "Cable", "_toggle_charger_connected")
	_add_web_button(actions, "Charge", "_toggle_charging_active")
	_add_web_button(actions, "Drive", "_toggle_drive_mode")
	_add_web_button(actions, "Head", "_toggle_headlights")
	_add_web_button(actions, "Stops", "_toggle_brake_lights")
	_add_web_button(actions, "Cam", "_send_camera_move")
	_add_web_button(actions, "Orbit", "_toggle_free_orbit")
	_add_web_button(actions, "Light", "_cycle_lighting_mode")
	_add_web_button(actions, "Theme", "_toggle_theme")


func _add_web_button(parent: Control, text: String, method: String, binds: Array = []):
	var button = Button.new()
	button.text = text
	button.rect_min_size = Vector2(58, 34)
	button.focus_mode = Control.FOCUS_NONE
	parent.add_child(button)
	button.connect("pressed", self, method, binds)


func _sync_main_view_frame_to_viewport(animated: bool, force: bool = false):
	var viewport_size = get_viewport().size
	if viewport_size.x <= 0 or viewport_size.y <= 0:
		return
	if not force and viewport_size == last_main_view_frame_size:
		return

	last_main_view_frame_size = viewport_size
	_enqueue("UPDATE_MAIN_VIEW_FRAME", {
		"top_margin": 0,
		"left_margin": 0,
		"width": viewport_size.x,
		"height": viewport_size.y,
		"animated": animated,
		"scroll_fraction": 1,
	})


