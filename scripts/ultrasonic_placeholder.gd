tool 
extends ImmediateGeometry

enum STYLE{M3 = 0, SX = 1}
export (STYLE) var style setget set_style
func set_style(v):
	style = v;
	update();


export (bool) var active setget set_active
func set_active(v):
	active = v;
	update();

enum TYPE{PARK_FRONT = 0, PARK_REAR = 1, BLIND_FRONT = 2, BLIND_REAR = 3}
export (TYPE) var type setget set_type
func set_type(v):
	type = v;
	update();

func _ready():
	update();

func update_blindspot_texture():
	material_override.set_shader_param("colorRamp", load("res://misc_textures/side_collision_warning_color_ramp.png"));

func update_park_texture():
	if (active):
		material_override.set_shader_param("colorRamp", load("res://misc_textures/park_assist_active.png"));
	else:
		material_override.set_shader_param("colorRamp", load("res://misc_textures/park_assist_inactive.png"));

func update():
	clear();
	begin(Mesh.PRIMITIVE_TRIANGLE_STRIP);
	match type:
		TYPE.PARK_FRONT:
			if Engine.editor_hint: dummy_front();
			update_park_texture();
		TYPE.PARK_REAR:
			if Engine.editor_hint: dummy_rear();
			update_park_texture();
		TYPE.BLIND_FRONT:
			if Engine.editor_hint: dummy_blind_front();
			update_blindspot_texture();
		TYPE.BLIND_REAR:
			if Engine.editor_hint: dummy_blind_rear();
			update_blindspot_texture();
	end();
	
