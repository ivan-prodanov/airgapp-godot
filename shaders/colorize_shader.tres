[resource]
resource_local_to_scene = true
code = "shader_type spatial;
render_mode depth_draw_never, unshaded;

uniform vec4 color : hint_color;
uniform sampler2D TextureUniform : hint_black;



void vertex() {
// Output:0

}

void fragment() {
// ColorUniform:3
	vec3 n_out3p0;
	float n_out3p1;
	n_out3p0 = color.rgb;
	n_out3p1 = color.a;

// TextureUniform:7
	vec3 n_out7p0;
	float n_out7p1;
	{
		vec4 n_tex_read = texture( TextureUniform , UV.xy );
		n_out7p0 = n_tex_read.rgb;
		n_out7p1 = n_tex_read.a;
	}

// VectorDecompose:6
	float n_out6p0;
	float n_out6p1;
	float n_out6p2;
	n_out6p0 = n_out7p0.x;
	n_out6p1 = n_out7p0.y;
	n_out6p2 = n_out7p0.z;

// Output:0
	ALBEDO = n_out3p0;
	ALPHA = n_out6p0;

}

void light() {
// Output:0

}
"
