code = "shader_type spatial;
render_mode cull_disabled, specular_disabled, unshaded, shadows_disabled, ambient_light_disabled;

uniform vec4 lane_color : hint_color;
uniform sampler2D tex_frg_2 : hint_albedo;



void vertex() {
// Output:0

}

void fragment() {
// ColorUniform:7
	vec3 n_out7p0 = lane_color.rgb;
	float n_out7p1 = lane_color.a;

// Color:16
	vec3 n_out16p0 = vec3(1.000000, 1.000000, 1.000000);
	float n_out16p1 = 1.000000;

// VectorOp:5
	vec3 n_out5p0 = n_out7p0 * n_out16p0;

// Input:3
	vec3 n_out3p0 = vec3(UV, 0.0);

// VectorDecompose:13
	float n_out13p0 = n_out3p0.x;
	float n_out13p1 = n_out3p0.y;
	float n_out13p2 = n_out3p0.z;

// VectorCompose:17
	float n_in17p2 = 0.00000;
	vec3 n_out17p0 = vec3(n_out13p1, n_out13p0, n_in17p2);

// Texture:2
	vec4 tex_frg_2_read = texture(tex_frg_2, n_out17p0.xy);
	vec3 n_out2p0 = tex_frg_2_read.rgb;
	float n_out2p1 = tex_frg_2_read.a;

// ScalarOp:18
	float n_in18p1 = 0.50000;
	float n_out18p0 = pow(n_out2p1, n_in18p1);

// ScalarOp:6
	float n_out6p0 = n_out7p1 * n_out18p0;

// Output:0
	ALBEDO = n_out5p0;
	ALPHA = n_out6p0;

}

void light() {
